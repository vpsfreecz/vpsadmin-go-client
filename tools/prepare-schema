#!/usr/bin/env python3
"""Apply the bounded compatibility projections for the pinned Go generator."""

import argparse
import json
from pathlib import Path


def main():
    root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", nargs="?", type=Path,
                        default=root / "schema/source-api-7.0.json")
    parser.add_argument("output", nargs="?", type=Path,
                        default=root / "schema/api-7.0.json")
    args = parser.parse_args()

    try:
        if args.source.resolve() == args.output.resolve():
            raise ValueError("source and output must be different files")
        schema = json.loads(args.source.read_text(encoding="utf-8"))
        expected = {
            "schema_format": 1,
            "api_version": "7.0",
            "protocol_version": "2.0",
            "profile": "vpsadmin-full-fixture",
            "mount_path": "/",
            "source_url": "https://schema.invalid/v7.0/",
        }
        for key, value in expected.items():
            actual = schema[key]
            if type(actual) is not type(value) or actual != value:
                raise ValueError("unexpected source " + key)

        oauth2 = schema["description"]["authentication"]["oauth2"]
        if oauth2["revoke_url"] != "http://api.test/_auth/oauth2/revoke":
            raise ValueError("unexpected source OAuth revocation URL")

        resources = schema["description"]["resources"]
        child = resources["vps"]["resources"]["evidence"]
        fleet = resources["vps_evidence"]
        for resource, path, scope, namespace in (
            (child, "/v7.0/vpses/{vps_id}/evidence", "vps.evidence#index", "evidence"),
            (fleet, "/v7.0/vps_evidence", "vps_evidence#index", "vps_evidence"),
        ):
            if resource["resources"] != {} or set(resource["actions"]) != {"index"}:
                raise ValueError("unexpected evidence resource shape")
            action = resource["actions"]["index"]
            if (action["method"] != "GET" or action["path"] != path
                    or action["scope"] != scope or action["auth"] is not True
                    or action["input"]["layout"] != "object"
                    or action["input"]["namespace"] != namespace
                    or action["output"]["layout"] != "object_list"
                    or action["output"]["namespace"] != namespace):
                raise ValueError("unexpected evidence index signature")

        # Child and fleet otherwise overwrite the same generated Go names.
        # The full child contract remains in the raw source schema.
        del resources["vps"]["resources"]["evidence"]
        oauth2["revoke_url"] = "https://auth.vpsfree.cz/_auth/oauth2/revoke"
        output = json.dumps(schema, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
        args.output.write_text(output, encoding="utf-8")
    except (OSError, ValueError, KeyError, TypeError) as error:
        parser.exit(1, "prepare-schema: " + str(error) + "\n")


if __name__ == "__main__":
    main()
